{
  "name": "snappit-daily",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Snappit-tyylinen päivittäinen videopäiväkirja PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "android:assets": "node scripts/make-android-assets.mjs && capacitor-assets generate --android --iconBackgroundColor '#f6f1e8' --iconBackgroundColorDark '#1c1916' --splashBackgroundColor '#f6f1e8' --splashBackgroundColorDark '#1c1916'",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew bundleRelease assembleRelease"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vili-pet/snappit-daily.git"
  },
  "author": "Vili-Petteri",
  "license": "MIT",
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.35.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
